# ─── LLM provider ──────────────────────────────────────────────────
# "anthropic" = paid Claude (default, smartest). "ollama" = free local GPU.
SCAWWARD_PROVIDER=anthropic

# ─── Anthropic / Claude ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SCAWWARD_MODEL=claude-sonnet-4-5
SCAWWARD_FAST_MODEL=claude-haiku-4-5
SCAWWARD_VISION_MODEL=claude-sonnet-4-5
SCAWWARD_MAX_TOKENS=4096
SCAWWARD_TEMPERATURE=0.2

# ─── Ollama (local GPU) ────────────────────────────────────────────
# Used when SCAWWARD_PROVIDER=ollama. Make sure `ollama serve` is running.
# Models tested with tool calling: llama3.1, qwen2.5-coder, mistral-nemo.
SCAWWARD_OLLAMA_HOST=http://127.0.0.1:11434
SCAWWARD_OLLAMA_MODEL=llama3.1:latest
SCAWWARD_OLLAMA_TIMEOUT=300.0

# ─── Server ────────────────────────────────────────────────────────
SCAWWARD_HOST=127.0.0.1
SCAWWARD_PORT=8765
SCAWWARD_LOG_LEVEL=INFO
SCAWWARD_DEBUG=true

# ─── Database ──────────────────────────────────────────────────────
# SQLite for solo dev, swap to Postgres later
SCAWWARD_DB_URL=sqlite+aiosqlite:///./data/scawward.db
SCAWWARD_VECTOR_DB_PATH=./data/chroma

# ─── Security ──────────────────────────────────────────────────────
# Confirm-before-execute for risky actions (rm, network, etc.)
SCAWWARD_REQUIRE_CONFIRMATION=true
SCAWWARD_SANDBOX_ROOT=./data/sandbox
SCAWWARD_ALLOWED_PATHS=C:\Users\You\Documents,C:\Users\You\Downloads
SCAWWARD_BLOCKED_PATHS=C:\Windows,C:\Program Files

# ─── Vision ────────────────────────────────────────────────────────
SCAWWARD_SCREENSHOT_INTERVAL=5
SCAWWARD_SCREENSHOT_DOWNSCALE=0.5

# ─── Cache ─────────────────────────────────────────────────────────
SCAWWARD_CACHE_TTL=3600
SCAWWARD_PROMPT_CACHE_ENABLED=true
